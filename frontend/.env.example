# Only needed when the API is hosted separately from the frontend.
# Leave blank in local development; Vite proxies /api to http://localhost:4000.
VITE_API_URL=

# Public storefront URL, used for canonical links, OG tags and sitemap URLs.
# Example: https://studentsoko.co.ke
VITE_SITE_URL=

# Support email shown in the footer and on order pages.
VITE_CONTACT_EMAIL=hello@studentsoko.co.ke

# WhatsApp number in international format, digits only (no + or spaces).
# Example: 254712345678. Leave blank to hide the WhatsApp button.
VITE_WHATSAPP_NUMBER=

# Social profile URLs. Leave any value blank to hide that icon.
# Example values: https://instagram.com/your-handle
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_X_URL=
VITE_YOUTUBE_URL=
VITE_FACEBOOK_URL=

# Privacy-friendly analytics (optional). The script is only loaded when a
# domain is set. Leave blank to disable analytics completely.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js
