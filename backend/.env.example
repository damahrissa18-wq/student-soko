# ---------------------------------------------------------------------------
# Database — MongoDB (required)
# ---------------------------------------------------------------------------
# Atlas connection string. Paste the full string (with credentials) or leave the
# credentials out and set MONGODB_USERNAME / MONGODB_PASSWORD separately.
MONGODB_URI=mongodb+srv://cluster0.example.mongodb.net
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Database name inside the cluster. Created automatically on first write.
MONGODB_DB=studentsoko

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Delivery (must match frontend/src/data/shop.js)
# ---------------------------------------------------------------------------
FREE_DELIVERY_AT=2000
DELIVERY_FEE=150

# ---------------------------------------------------------------------------
# Email — Resend (https://resend.com)
# ---------------------------------------------------------------------------
# Without an API key, emails are printed to the server console instead of sent.
RESEND_API_KEY=
# The from address must use a domain you have verified in Resend.
RESEND_FROM_EMAIL=StudentsSoko <orders@your-verified-domain.com>
RESEND_REPLY_TO=support@your-verified-domain.com
# Set to "log" to force console logging even when an API key is configured.
EMAIL_MODE=

# ---------------------------------------------------------------------------
# M-Pesa — Safaricom Daraja
# ---------------------------------------------------------------------------
# Leave the credentials blank to run in mock mode: payments confirm
# automatically after ~5 seconds and no real money moves.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill / till number. 174379 is the Daraja sandbox shortcode.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Must be a public HTTPS URL that Safaricom can reach, for example an ngrok
# tunnel pointing at this server: https://xxxx.ngrok-free.app/api/mpesa/callback
MPESA_CALLBACK_URL=
# Set to "true" to force mock payments even when credentials are configured.
MPESA_MOCK=

# ---------------------------------------------------------------------------
# Site + admin
# ---------------------------------------------------------------------------
# Public storefront URL used for tracking links in emails. Set this to your
# real domain in production.
SITE_URL=http://localhost:5173
# Bearer token for /api/admin. In development an empty value falls back to
# "dev-admin-token". Production requires an explicit token.
ADMIN_TOKEN=
# Set to production on your host. Outside production, a blank ADMIN_TOKEN gets
# the development fallback; production requires a real token.
# NODE_ENV=production
# Variants at or below this quantity are flagged as low stock.
LOW_STOCK_THRESHOLD=3

# ---------------------------------------------------------------------------
# Abandoned cart reminders
# ---------------------------------------------------------------------------
# Sends one reminder email per unpaid order after the delay. Disable if you do
# not want automated reminders.
ABANDONED_CART_ENABLED=true
ABANDONED_CART_DELAY_MINUTES=60
ABANDONED_CART_SWEEP_MINUTES=15
ABANDONED_CART_MAX_AGE_DAYS=7

# ---------------------------------------------------------------------------
# Legacy JSON import (optional)
# ---------------------------------------------------------------------------
# Orders, stock and subscribers now live in MongoDB. These paths are only read
# by `npm run db:migrate` when importing the old JSON files in backend/data/.
# ORDER_STORE_FILE=C:\path\to\orders.json
# INVENTORY_STORE_FILE=C:\path\to\inventory.json
# SUBSCRIBER_STORE_FILE=C:\path\to\subscribers.json
